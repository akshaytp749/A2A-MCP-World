# Copy to .env (gitignored) and fill in. Secrets via env only (CLAUDE.md rule 5).

# --- LLM providers (free tiers) ---
# Minimum to see the minds think: a free Google AI Studio key.
GEMINI_API_KEY=

# Optional extra free providers (router fallback chain). Leave blank to skip.
GROQ_API_KEY=            # console.groq.com — free, no card
OPENROUTER_API_KEY=      # openrouter.ai — free :free models
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Observability (optional; enables tracing + prompt management + scores) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Ops ---
ADMIN_TOKEN=dev-admin-token   # change for any non-local run
# LLM_DAILY_QUOTA=1000        # per-NPC-process daily request ceiling
